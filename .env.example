# =====================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
# =====================================================================

# Jenkins initial admin user (created on first boot if using JCasC)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-before-use

# Port Jenkins binds to on the host (loopback only for security)
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000

# Internal DinD endpoint used by the docker CLI inside Jenkins
DOCKER_HOST=tcp://dind:2375

# Registry push target (used by Jenkinsfile; usually set in Jenkins creds instead)
REGISTRY=docker.io
IMAGE_NAME=yourdockerhubuser/isec6000-app
